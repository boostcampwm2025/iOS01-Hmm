{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "venv",
        ".venv",
        ".git",
        "__pycache__",
        "*.pyc",
        ".pytest_cache",
        "tests",
        "pytest.ini",
        "requirements-dev.txt",
        "run_tests.sh",
        "README.md",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "firestore-debug.log",
        "firestore-debug.*.log",
        "*.local"
      ],
      "runtime": "python314"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
